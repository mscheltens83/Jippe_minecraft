{
  "name": "jippecraft",
  "version": "1.0.0",
  "private": true,
  "description": "Een Minecraft-achtig bouwspel voor kinderen, speelbaar op de iPad.",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "lint": "eslint .",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:browser": "node tests/smoke.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "1.56.1"
  }
}
